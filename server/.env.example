# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Individual Parameters)
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=inventory_dev
DB_HOST=127.0.0.1

# Database Configuration (Production URL - Alternative for use_env_variable: DATABASE_URL)
# DATABASE_URL=postgresql://rakman_user:your_secure_password@127.0.0.1:5432/rakman_prod

# JWT Secret (MUST be a strong, unique, and random secret in production)
JWT_SECRET=your_jwt_secret_key_here
